{% extends 'base.html.twig' %}
{% block title %}{{ 'dashboard.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">{{ 'dashboard.title'|trans }}</h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">
                {{ 'dashboard.people_count'|trans({'%count%': people|length}) }}
            </p>
        </div>
        <a href="{{ path('person_new') }}"
           class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl transition font-medium text-sm shadow-sm">
            {{ 'btn.add_person'|trans }}
        </a>
    </div>

    {% if people is empty %}
        <div class="text-center py-20 bg-white dark:bg-gray-900 rounded-2xl border-2 border-dashed border-gray-200 dark:border-gray-700">
            <svg class="mx-auto h-12 w-12 text-gray-300 dark:text-gray-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-gray-400 dark:text-gray-500 text-lg font-medium">{{ 'dashboard.empty'|trans }}</p>
            <a href="{{ path('person_new') }}"
               class="mt-4 inline-block text-indigo-600 dark:text-indigo-400 font-semibold hover:underline text-sm">
                {{ 'dashboard.add_first'|trans }}
            </a>
        </div>
    {% else %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            {% for person in people %}
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md hover:border-indigo-100 dark:hover:border-indigo-700 transition-all duration-200 p-5 flex flex-col">
                    <div class="flex items-start justify-between mb-2">
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 leading-tight">{{ person.name }}</h2>
                        {% if person.isOnHold %}
                            <span class="ml-2 shrink-0 inline-flex items-center px-2 py-0.5 bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 text-xs font-semibold rounded-full">
                                {{ 'badge.on_hold'|trans }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="text-sm text-gray-400 dark:text-gray-500 mb-4 space-y-0.5">
                        <p>{{ 'person.active_items'|trans({'%count%': person.activeItemCount}) }}</p>
                        <p class="text-xs">
                            {{ 'person.updated_label'|trans }}
                            {{ person.lastModifiedAt
                                ? person.lastModifiedAt|date('Y.m.d')
                                : person.createdAt|date('Y.m.d') }}
                        </p>
                    </div>

                    <div class="mt-auto pt-3 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between">
                        <a href="{{ path('person_show', {'id': person.id}) }}"
                           class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition">
                            {{ 'btn.view_wishlist'|trans }}
                        </a>
                        <div class="flex items-center gap-3">
                            <a href="{{ path('person_edit', {'id': person.id}) }}"
                               class="text-xs text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition">
                                {{ 'btn.edit'|trans }}
                            </a>
                            <form action="{{ path('person_toggle_hold', {'id': person.id}) }}" method="post" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-hold' ~ person.id) }}">
                                <button type="submit"
                                        class="text-xs text-gray-400 dark:text-gray-500 hover:text-amber-600 dark:hover:text-amber-400 transition">
                                    {{ person.isOnHold ? 'btn.unfreeze'|trans : 'btn.freeze'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
